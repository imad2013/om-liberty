apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: orders-ingress
  namespace: {{ orders_namespace }}
  annotations:
    kubernetes.io/ingress.class: "{{ orders_ingress_class }}"
spec:
  rules:
    - host: {{ orders_ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: orders-service
                port:
                  number: 80
