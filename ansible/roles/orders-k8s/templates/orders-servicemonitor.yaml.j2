apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: orders-service-monitor
  namespace: {{ orders_namespace }}
spec:
  selector:
    matchLabels:
      app: orders-service
  namespaceSelector:
    matchNames:
      - {{ orders_namespace }}
  endpoints:
    - port: http
      path: /metrics
      interval: {{ orders_servicemonitor_interval }}
