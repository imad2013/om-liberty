apiVersion: apps/v1
kind: Deployment
metadata:
  name: orders-service
  namespace: {{ orders_namespace }}
spec:
  replicas: {{ orders_replicas }}
  selector:
    matchLabels:
      app: orders-service
  template:
    metadata:
      labels:
        app: orders-service
    spec:
      containers:
        - name: liberty
          image: {{ orders_image }}
          imagePullPolicy: {{ orders_image_pull_policy }}
          ports:
            - containerPort: 9080
          readinessProbe:
            httpGet:
              path: /health/ready
              port: 9080
            initialDelaySeconds: 45
            periodSeconds: 10
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health/live
              port: 9080
            initialDelaySeconds: 60
            periodSeconds: 15
            failureThreshold: 6
          env:
            - name: MP_METRICS_TAGS
              value: "version={{ orders_service_version }}"
            - name: ORDERS_DB_URL
              value: "{{ orders_db_jdbc_url if orders_db_jdbc_url | default('', true) | length > 0 else 'jdbc:oracle:thin:@//' ~ oracle_service_name ~ ':' ~ oracle_port ~ '/' ~ oracle_db }}"
            - name: ORDERS_DB_USER
              value: "{{ oracle_user }}"
            - name: ORDERS_DB_PASSWORD
              value: "{{ oracle_password }}"
            - name: ORDERS_KAFKA_BOOTSTRAP_SERVERS
              value: "{{ kafka_bootstrap_servers }}"
            - name: ORDERS_KAFKA_TOPIC
              value: "orders-events"
            - name: ORDERS_SERVICE_VERSION
              value: "{{ orders_service_version }}"
            - name: ORDERS_SECURITY_ENABLED
              value: "false"
