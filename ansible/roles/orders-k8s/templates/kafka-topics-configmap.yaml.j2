apiVersion: v1
kind: ConfigMap
metadata:
  name: kafka-topics-config
  namespace: {{ orders_namespace }}
data:
  topics.list: |
{% for topic in kafka_topics %}
    {{ topic.name }} {{ topic.partitions }} {{ topic.replication_factor }} {% for key, value in topic.config.items() %}{{ key }}={{ value }} {% endfor %}

{% endfor %}
  create-topics.sh: |
    #!/usr/bin/env bash
    set -euo pipefail
    BOOTSTRAP="${KAFKA_BOOTSTRAP_SERVERS:-{{ kafka_bootstrap_servers }}}"
    TOPICS_LIST="${KAFKA_TOPICS_LIST:-/etc/kafka/topics.list}"
    KAFKA_TOPICS_BIN="/opt/kafka/bin/kafka-topics.sh"
    for i in $(seq 1 30); do
      if "${KAFKA_TOPICS_BIN}" --bootstrap-server "${BOOTSTRAP}" --list >/dev/null 2>&1; then
        break
      fi
      sleep 2
    done
    while read -r name partitions replication configs; do
      [[ -z "${name}" || "${name}" == \#* ]] && continue
      args=(--bootstrap-server "${BOOTSTRAP}" --create --if-not-exists --topic "${name}" --partitions "${partitions}" --replication-factor "${replication}")
      if [[ -n "${configs}" ]]; then
        read -r -a config_array <<< "${configs}"
        for cfg in "${config_array[@]}"; do
          args+=(--config "${cfg}")
        done
      fi
      "${KAFKA_TOPICS_BIN}" "${args[@]}"
    done < "${TOPICS_LIST}"
    "${KAFKA_TOPICS_BIN}" --bootstrap-server "${BOOTSTRAP}" --list
